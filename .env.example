GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
OPENCODE_VERSION=1.18.34
# HTTPS profile: set the actual domain, origin and secure cookies.
GATEWAY_DOMAIN=gateway.example.com
GATEWAY_PUBLIC_ORIGIN=
GATEWAY_SECURE_COOKIES=false
# When using the bundled Caddy service, set to its Docker network subnet.
# Other reverse proxies: set only their address/subnet, never untrusted clients.
GATEWAY_TRUSTED_PROXIES=127.0.0.1
